<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX manifest for the Microsoft Store channel.

  {VERSION} is replaced by build_msix.ps1 with the 4-part form of the version
  in src/version.py (e.g. 2.9.6 -> 2.9.6.0). The Store rejects any package
  whose fourth part is not 0, because Microsoft reserves it.

  The three identity values below come from Partner Center
  (product "Cortex AI IDE" -> View product identity) and must match
  CHARACTER-FOR-CHARACTER or the upload is rejected:

      Package/Identity/Name                    WACampaignSender.CortexAIIDE
      Package/Identity/Publisher               CN=08281551-...
      Package/Properties/PublisherDisplayName  Pasons Group

  The "WACampaignSender" prefix is a PERMANENT account-level identifier
  assigned when the account first registered. It is NOT the display name and
  cannot be changed (deleting and re-reserving the product reproduces it).
  Customers never see it: it appears only in the install path and in
  Get-AppxPackage output. What customers see is PublisherDisplayName.

  The FILE_TYPE_ASSOCIATIONS placeholder inside <Application> is replaced by
  build_msix.ps1 with the file types from src/core/file_associations.py
  (gen_file_assoc.py msix; it fails the build if the placeholder survives,
  so never write it in braces anywhere else in this file): they put Cortex
  in "Open with" and in Settings > Default apps. Windows passes the file path
  to Cortex.exe as its first argument.

  runFullTrust is required: Cortex spawns PowerShell/ConPTY terminals, runs
  git and other subprocesses, and edits project folders anywhere on disk.
  It must be justified in the Store submission notes.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="WACampaignSender.CortexAIIDE"
    Publisher="CN=08281551-5480-43B8-BB1D-48E770DB3BD3"
    Version="{VERSION}"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Cortex AI IDE</DisplayName>
    <PublisherDisplayName>Pasons Group</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!-- 1809 matches the minimum advertised on cortex-ide.app. -->
    <TargetDeviceFamily Name="Windows.Desktop"
                        MinVersion="10.0.17763.0"
                        MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="CortexAIIDE"
                 Executable="Cortex.exe"
                 EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Cortex AI IDE"
        Description="AI coding IDE with an agentic assistant, integrated terminal, Git and multi-model support."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          Square310x310Logo="Assets\Square310x310Logo.png"
          Square71x71Logo="Assets\Square71x71Logo.png" />
      </uap:VisualElements>
      {FILE_TYPE_ASSOCIATIONS}
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
