# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/
build/
dist/
develop-eggs/
downloads/
wheels/
.venv/
venv/
env/
ENV/
.python-version

# --- Test / type / lint caches -------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.hypothesis/

# --- Local runtime state --------------------------------------------------
# Cortex keeps user state in ~/.cortex.  A .cortex folder inside the project
# is machine-local noise: profiles, usage counters, staged diffs, logs and
# the generated semantic index (which alone is 60+ MB).
.cortex/
src/.cortex/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
logs/
*.log

# --- Node.js --------------------------------------------------------------
# The editor pane loads Monaco from node_modules/monaco-editor at the project
# root.  The contents are installed by `npm install` and must never be
# committed; package.json is what defines the dependency.
node_modules/
npm-debug.log*
yarn-error.log*
.pnpm-store/

# --- Vendored binaries ----------------------------------------------------
# bin/rg.exe (5 MB) is committed because the Grep tool needs it.
# bin/node/node.exe is 69 MB and is a copy of Node.js; install Node yourself
# instead (see README, "Install Node.js").  The app falls back to a system
# Node on PATH.
bin/node/

# --- Model / vector caches ------------------------------------------------
models/
*.onnx
*.safetensors
*.bin
*.pt
*.pth
.sentence_transformers/
.cache/

# --- Secrets --------------------------------------------------------------
# Never commit credentials.  Keys live in ~/.cortex/settings.json and the
# encrypted store, never in the repository.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets.json
credentials.json

# --- Build / packaging ----------------------------------------------------
# The macOS PyInstaller spec stays in the source so that build is reproducible
# from a clone. Everything else here is local build configuration and is not
# published.
#
# cortex.spec and cortex_setup.iss are kept out of the repository by request:
# they hold local machine paths and packaging options. The MSIX manifest holds
# Partner Center account identity (package name and publisher distinguished
# name), so it must never be committed. Keep a local copy before a release
# build; build.ps1 and build_tools/msix/build_msix.ps1 both read them.
*.spec
!cortex-macos.spec
*.iss
# The whole build_tools tree is local-only by request. It carries Partner Center
# account identity (AppxManifest.template.xml: package name, publisher DN,
# display name), generator output, and signing helpers. Keep a local copy before
# a release build; build.ps1 and build_tools/msix/build_msix.ps1 both read it.
build_tools/
*.msix
*.msixbundle
*.appx
*.appxbundle
output/
release/
installer/
installer_output/
msix_output/
# Build channel marker, generated by build.ps1 on every build.
src/_build_info.py
# PyInstaller intermediate work folder.
build/

# --- Editor / OS ----------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
Thumbs.db
desktop.ini
Desktop.ini
$RECYCLE.BIN/

# --- Scratch --------------------------------------------------------------
.cortex/lab/
.cortex/scratchpad/
.cortex/Diff/
AGENT_AUDIT.md
*.tmp
tmp_*.py
_*_check.py
_*_sync.py

# --- Internal docs ---------------------------------------------------------
# Clean-room engine notes stay local; they are not part of the shipped source.
Docs/
